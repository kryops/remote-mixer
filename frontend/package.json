{
  "name": "@remote-mixer/frontend",
  "version": "0.0.1",
  "repository": "https://github.com/kryops/remote-mixer",
  "author": "Michael Manzinger <michael@kryops.de>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "analyze": "webpack --config ./webpack.config.ts --env production --env analyze",
    "build:base": "cross-env NODE_OPTIONS=--no-experimental-strip-types webpack --config ./webpack.config.ts",
    "build": "cross-env NODE_ENV=production yarn build:base --env production",
    "build:dev": "yarn build:base",
    "build:profile": "yarn build:base --env profile",
    "build:profileReact": "yarn build:base --env profileReact",
    "clean": "rimraf dist",
    "lint:css": "stylelint '**/*.@(ts|tsx)'",
    "dev": "cross-env NODE_OPTIONS=--no-experimental-strip-types webpack serve --config ./webpack.config.ts",
    "tsc:watch": "tsc -b --watch"
  },
  "dependencies": {
    "@remote-mixer/controls": "*",
    "@remote-mixer/types": "*",
    "@remote-mixer/utils": "*"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/plugin-transform-runtime": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/runtime": "^8.1.2",
    "@linaria/core": "^8.3.0",
    "@linaria/postcss-linaria": "^8.3.0",
    "@linaria/react": "^8.3.0",
    "@mdi/js": "^7.4.47",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@swc/core": "^1.16.22",
    "@types/loader-utils": "^3.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@wyw-in-js/webpack-loader": "^2.7.2",
    "babel-loader": "^10.1.1",
    "cnbuilder": "^3.1.0",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "emittery": "^2.2.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "normalize.css": "^8.0.1",
    "polished": "^4.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-refresh": "^0.19.0",
    "speed-measure-webpack-plugin": "^1.6.0",
    "stacktrace-js": "^2.0.2",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.3",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
