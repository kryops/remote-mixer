{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "isolatedModules": true,
    "jsx": "react",
    "lib": ["esnext"],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": false,
    "paths": {
      "osc": ["./@types/osc"],
      "midi": ["./@types/midi"],
      "@remote-mixer/controls": ["./shared/controls/src"],
      "@remote-mixer/types": ["./shared/types/src"],
      "@remote-mixer/utils": ["./shared/utils/src"],
    },
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedSideEffectImports": false,
    "types": ["node", "jest", "react", "react-dom"],
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "incremental": true
  },
  "include": [
    "frontend/src",
    "frontend/test",
    "backend/src",
    "backend/test",
    "shared",
    "@types"
  ]
}
