{
  "name": "@kryops/remote-mixer",
  "version": "0.0.1",
  "main": "backend/dist/index.js",
  "repository": "https://github.com/kryops/remote-mixer",
  "author": "Michael Manzinger <michael@kryops.de>",
  "license": "MIT",
  "private": true,
  "workspaces": {
    "packages": [
      "backend",
      "frontend",
      "shared/*"
    ]
  },
  "scripts": {
    "all": "yarn lint && yarn test && yarn build",
    "clean": "yarn workspaces foreach -A run clean && rimraf node_modules/.cache .linaria-cache tsconfig.tsbuildinfo",
    "backend": "yarn workspace @remote-mixer/backend",
    "build": "yarn run clean && run-p 'backend build' 'frontend build'",
    "frontend": "yarn workspace @remote-mixer/frontend",
    "lint": "run-p --continue-on-error lint:oxlint lint:ts lint:format 'frontend lint:css'",
    "lint:oxlint": "vp lint",
    "lint:ts": "tsc -b frontend backend",
    "lint:ts:watch": "tsc -b frontend backend --watch",
    "lint:format": "vp fmt --check",
    "prepare": "vp config && rimraf node_modules/.cache .linaria-cache && yarn build",
    "format": "vp fmt",
    "prod": "run-s build start",
    "dev": "run-p 'backend dev' 'frontend dev' 'backend build --watch --preserveWatchOutput' 'frontend tsc:watch'",
    "start": "cross-env NODE_ENV=production && node .",
    "test": "vp test run"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.4",
    "rimraf": "^6.1.4",
    "type-fest": "^6.0.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  }
}
